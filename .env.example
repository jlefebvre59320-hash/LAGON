NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon
NEXT_PUBLIC_SITE_URL=https://tikanal.com
NEXT_PUBLIC_LEGAL_EDITOR_NAME=Nom ou raison sociale
NEXT_PUBLIC_LEGAL_EDITOR_ADDRESS=Adresse postale complète
NEXT_PUBLIC_LEGAL_PUBLICATION_DIRECTOR=Nom du directeur de publication
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=contact@tikanal.com

# --- Notification par email d'un message reçu -----------------------------
# Ces trois-là ne portent pas le préfixe NEXT_PUBLIC_ : c'est volontaire.
# Une variable NEXT_PUBLIC_ est inscrite en clair dans le JavaScript envoyé
# aux visiteurs. Celles-ci ne doivent jamais quitter le serveur.
#
# Sans elles, le site fonctionne : les messages arrivent, la pastille
# s'allume, seul l'email de notification n'est pas envoyé.

# Supabase → Settings → API → service_role. Elle contourne la RLS :
# à ne mettre que dans les variables d'environnement du serveur.
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role

# Resend → API Keys. La même que celle du SMTP, ou une clé dédiée.
RESEND_API_KEY=votre-cle-resend

# Doit être une adresse du domaine vérifié chez Resend.
MAIL_FROM=Ti Kanal <notifications@tikanal.com>

# --- Notifications sur le téléphone (push) --------------------------------
# Paire de clés VAPID, à générer une seule fois :
#   npx web-push generate-vapid-keys
# La publique porte le préfixe NEXT_PUBLIC_ : elle est faite pour être
# connue du navigateur. La privée ne quitte jamais le serveur.
#
# Ces clés ne donnent accès à aucune donnée : elles ne servent qu'à
# signer les envois de notifications. Les régénérer coupe simplement les
# abonnements existants, que les visiteurs réactivent d'un clic.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=votre-cle-publique
VAPID_PRIVATE_KEY=votre-cle-privee
# Adresse de contact exigée par la norme, en cas de problème d'envoi.
VAPID_SUBJECT=mailto:contact@tikanal.com
