{
  "manifest_version": 3,
  "name": "Flux — capture d'activité",
  "version": "0.1.0",
  "description": "Envoie l'onglet actif (site, page, durée) au serveur Flux local. Rien ne part sur Internet.",
  "permissions": ["tabs", "idle", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options.html",
  "action": { "default_title": "Flux", "default_popup": "options.html" }
}
